{
  "name": "@dank-inc/react-loco-storage",
  "version": "0.4.0",
  "author": "Elijah Lucian",
  "description": "The craziest local storage react hook ever invented!.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucian-labs/react-loco-storage.git"
  },
  "bugs": {
    "url": "https://github.com/lucian-labs/react-loco-storage/issues"
  },
  "homepage": "https://react-loco-storage.lucianlabs.ca",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "ISC",
  "keywords": [
    "react",
    "hook",
    "local storage",
    "state",
    "typescript"
  ],
  "scripts": {
    "lint": "tsc --noEmit",
    "audit": "npm audit --audit-level=\"moderate\"",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc",
    "prepublishOnly": "npm run compile",
    "deploy": "npm publish",
    "test": "vitest run --environment jsdom",
    "demo": "vite --config vite.demo.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts"
  },
  "peerDependencies": {
    "react": "^17.0.2 || ^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^9.1.1",
    "typescript": "^4.2.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
